# Repo-scoped toolchain via direnv (standing rule: no system-wide tools).
#
#   direnv allow          # activate the core toolchain on entry
#   PROTONWIRE_GUI=1 direnv allow   # + webkit2gtk (protonwire-gui builds)
#
# `use nix` evaluates shell.nix (classic, not flake — the repository's
# reftable ref storage is unreadable by Nix's libgit2; see
# docs/review-log.md).
if [ "${PROTONWIRE_GUI:-0}" = "1" ]; then
  use nix --arg gui true
else
  use nix
fi
