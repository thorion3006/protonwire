{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServerMessage",
  "description": "A daemon → client message.\n\nAdjacently tagged (`type` + `data`) so nested tagged enums such as\n[`Response`] keep their own discriminant without colliding with this\none on the wire.",
  "oneOf": [
    {
      "description": "Successful handshake reply.",
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/$defs/HelloAck"
        },
        "type": {
          "type": "string",
          "const": "hello-ack"
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "description": "Handshake refusal; the daemon closes the connection afterwards.",
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/$defs/HelloError"
        },
        "type": {
          "type": "string",
          "const": "hello-error"
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "description": "Reply to a [`ClientMessage::Request`].",
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/$defs/Response"
        },
        "type": {
          "type": "string",
          "const": "response"
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "description": "A daemon-pushed event.",
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/$defs/EventEnvelope"
        },
        "type": {
          "type": "string",
          "const": "event"
        }
      },
      "required": [
        "type",
        "data"
      ]
    }
  ],
  "$defs": {
    "AccountStatus": {
      "description": "The account snapshot behind `account --json` (FR-7H): never a\nsecret, never a fabricated fact — absent fields mean unknown or\nnot-yet-wired, per the S6 discipline.",
      "type": "object",
      "properties": {
        "credential_source": {
          "description": "The resolved credential INPUT source (FR-7F).",
          "$ref": "#/$defs/CredentialSourceStatus"
        },
        "login_status": {
          "description": "The daemon account session's login status.",
          "$ref": "#/$defs/SessionStatus"
        },
        "persistence_health": {
          "description": "Persistence health, when the writable-store half reports one\n(ER-18). Absent until S5b/S5c wires the writable store — never\nfabricated.",
          "anyOf": [
            {
              "$ref": "#/$defs/PersistenceHealth"
            },
            {
              "type": "null"
            }
          ]
        },
        "writable_store": {
          "description": "The configured WRITABLE store (the S5b/S5c half).",
          "$ref": "#/$defs/WritableStoreStatus"
        }
      },
      "required": [
        "login_status",
        "credential_source",
        "writable_store"
      ]
    },
    "CatalogRefreshResult": {
      "description": "Outcome summary carried by [`Event::CatalogRefreshed`] (M2 S2):\nmirrors the S0 catalog seam's `fetch(etag) → Changed | NotModified`\nplus the stable refusal code on failure.",
      "oneOf": [
        {
          "description": "The refresh fetched and committed a new catalog revision.",
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "changed"
            }
          },
          "required": [
            "outcome"
          ]
        },
        {
          "description": "The upstream reported no change since the last fetch (an ETag\nmatch); the existing catalog stays authoritative.",
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "not-modified"
            }
          },
          "required": [
            "outcome"
          ]
        },
        {
          "description": "The refresh was refused or failed; `code` is the stable\nmachine-readable reason (for example a persisted ER-16\nsuppression surfacing as [`crate::RpcErrorCode::RateLimited`]).",
          "type": "object",
          "properties": {
            "code": {
              "description": "Stable refusal code.",
              "$ref": "#/$defs/RpcErrorCode"
            },
            "outcome": {
              "type": "string",
              "const": "failed"
            }
          },
          "required": [
            "outcome",
            "code"
          ]
        }
      ]
    },
    "CredentialSourceStatus": {
      "description": "The resolved credential input source (S5a's two arms).",
      "oneOf": [
        {
          "description": "Values arrive over the IPC surface (the S9 interactive\nprovider).",
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "const": "interactive"
            }
          },
          "required": [
            "source"
          ]
        },
        {
          "description": "Read-only import from the systemd credentials directory\n(FR-7F/FR-7J).",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "directory": {
                  "description": "The resolved `$CREDENTIALS_DIRECTORY`.",
                  "type": "string"
                },
                "startup_read": {
                  "description": "What the daemon's startup read of the preferred `session`\ncredential found (recorded once, never re-read mid-run).",
                  "$ref": "#/$defs/CredentialStartupRead"
                }
              },
              "required": [
                "directory",
                "startup_read"
              ]
            },
            "source": {
              "type": "string",
              "const": "systemd"
            }
          },
          "required": [
            "source",
            "data"
          ]
        }
      ]
    },
    "CredentialStartupRead": {
      "description": "The recorded outcome of the daemon's startup read of the systemd\n`session` credential — facts only, never value bytes.",
      "oneOf": [
        {
          "description": "A current, integral FR-7C envelope was readable (the\ntransactional import into the writable store is S5b's; this is\nthe input-half fact).",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "schema_version": {
                  "description": "The envelope's schema version.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                }
              },
              "required": [
                "schema_version"
              ]
            },
            "read": {
              "type": "string",
              "const": "read"
            }
          },
          "required": [
            "read",
            "data"
          ]
        },
        {
          "description": "The read refused; `reason` is the typed refusal's value-free\nsummary (the recorded skip reason).",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "reason": {
                  "description": "Value-free refusal summary.",
                  "type": "string"
                }
              },
              "required": [
                "reason"
              ]
            },
            "read": {
              "type": "string",
              "const": "refused"
            }
          },
          "required": [
            "read",
            "data"
          ]
        }
      ]
    },
    "DaemonState": {
      "description": "Full daemon state snapshot — the authoritative view clients resynchronize\nagainst (PRD FR-127D). Connection details (server, tunnel statistics,\nrequested-vs-applied features) join this struct in Milestone 4+ as\nadditive-optional fields, which are wire-compatible WITHOUT a protocol\nversion bump (old and new documents round-trip — see\n`snapshot_sequence_is_optional_on_the_wire` for the same rule on\n`latest_event_seq`). A version bump is reserved for representation\nchanges that break older readers: renaming or repurposing fields,\nchanging a field's type or semantics, or making a previously-optional\nfield mandatory.",
      "type": "object",
      "properties": {
        "active_owner_uid": {
          "description": "UID of the user who owns the active or most recent connection attempt,\nif any.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "daemon_version": {
          "description": "Daemon build version.",
          "type": "string"
        },
        "latest_event_seq": {
          "description": "Sequence number of the newest event already reflected in this\nsnapshot. Daemons that predate the field omit it; clients treat\n`None` as \"sequence unknown\" and fall back to their gap event.\n\nThe resynchronization race this closes (Codex PR review round 2,\nfinding 1): `GetState` is a separate request, so events can be\npublished while it is in flight and the snapshot can reflect\nsequences newer than the gap event that triggered the resync.\nPairing the snapshot with its own sequence lets the SDK advance\nits cursor coherently instead of replaying older buffered events\nafter the newer snapshot.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "network_integration": {
          "description": "Configured network integration mode (the configured value in Milestone\n1; the resolved adapter once Milestone 5 lands).",
          "$ref": "#/$defs/NetworkIntegration"
        },
        "protocol_version": {
          "description": "Protocol version the daemon speaks.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "vpn_state": {
          "description": "Current VPN state.",
          "$ref": "#/$defs/VpnState"
        }
      },
      "required": [
        "protocol_version",
        "daemon_version",
        "vpn_state",
        "network_integration"
      ]
    },
    "Event": {
      "description": "Daemon events. Milestone 1 carries state transitions and notices;\nMilestone 2 adds the catalog-refresh summary, the account-change\nsignal, and the scheduler notice (S2). Richer events remain additive\nvariants in later milestones.",
      "oneOf": [
        {
          "description": "The VPN state machine transitioned.",
          "type": "object",
          "properties": {
            "from": {
              "description": "Previous state.",
              "$ref": "#/$defs/VpnState"
            },
            "kind": {
              "type": "string",
              "const": "state-changed"
            },
            "to": {
              "description": "New state.",
              "$ref": "#/$defs/VpnState"
            }
          },
          "required": [
            "kind",
            "from",
            "to"
          ]
        },
        {
          "description": "An informational or warning notice worth surfacing in clients.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "notice"
            },
            "level": {
              "description": "Severity of the notice.",
              "$ref": "#/$defs/NoticeLevel"
            },
            "message": {
              "description": "Already-redacted human-readable text.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "level",
            "message"
          ]
        },
        {
          "description": "A server-catalog refresh finished; the result summary lets\nstatus surfaces report the last refresh outcome (FR-123) and\ntells clients when server data changed (FR-9).",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "catalog-refreshed"
            },
            "result": {
              "description": "Outcome summary of the finished refresh.",
              "$ref": "#/$defs/CatalogRefreshResult"
            }
          },
          "required": [
            "kind",
            "result"
          ]
        },
        {
          "description": "The authenticated account changed — login, logout, session\nrefresh or import, or a stored-credential mutation. A bare\nsignal: clients re-query account state (FR-7H) on receipt.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "account-changed"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "The single-flight metadata scheduler surfaced a condition worth\ndisplaying: the FR-11/FR-13I manual-refresh warning or an\nER-16 suppression notice. Same level+message shape as\n[`Event::Notice`], attributable to the scheduler so clients can\nroute it.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "scheduler-notice"
            },
            "level": {
              "description": "Severity of the notice.",
              "$ref": "#/$defs/NoticeLevel"
            },
            "message": {
              "description": "Already-redacted human-readable text.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "level",
            "message"
          ]
        }
      ]
    },
    "EventEnvelope": {
      "description": "Envelope for every daemon-pushed event. `seq` is monotonic per daemon\nprocess lifetime; a client that observes a gap must resynchronize with a\n[`crate::Request::GetState`] request (PRD FR-127D). The one value a real\nevent never carries is [`EVENT_SEQ_RESYNC_NOW`], reserved as the\nend-of-burst overflow signal above.",
      "type": "object",
      "properties": {
        "event": {
          "description": "The event payload.",
          "$ref": "#/$defs/Event"
        },
        "seq": {
          "description": "Monotonic sequence number, never [`EVENT_SEQ_RESYNC_NOW`] for a\ngenuine event.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "seq",
        "event"
      ]
    },
    "Fido2ChallengeParams": {
      "description": "The WebAuthn ceremony parameters of a FIDO2 challenge (the wire\nmirror of the adapter's reduced challenge).",
      "type": "object",
      "properties": {
        "allow_credentials": {
          "description": "Allowed credential IDs (the account's registered FIDO2 keys).",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            }
          }
        },
        "challenge": {
          "description": "The ceremony challenge bytes.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint8",
            "maximum": 255,
            "minimum": 0
          }
        }
      },
      "required": [
        "challenge",
        "allow_credentials"
      ]
    },
    "HelloAck": {
      "description": "Successful handshake reply.",
      "type": "object",
      "properties": {
        "daemon_version": {
          "description": "Daemon build version.",
          "type": "string"
        },
        "latest_event_seq": {
          "description": "Sequence number of the newest event emitted so far. A client that has\nseen a lower sequence performs a full-state resync via\n[`Request::GetState`].",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "protocol_version": {
          "description": "The protocol version the daemon will speak on this connection\n(≤ the client's requested version).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "protocol_version",
        "daemon_version",
        "latest_event_seq"
      ]
    },
    "HelloError": {
      "description": "Handshake refusal with a machine-readable reason.",
      "type": "object",
      "properties": {
        "reason": {
          "description": "Stable reason code, for example `unsupported-protocol-version`.",
          "type": "string"
        },
        "supported_version": {
          "description": "Highest protocol version the daemon supports.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "supported_version",
        "reason"
      ]
    },
    "LoginBlockedReason": {
      "description": "Stable reasons a login flow stops without a session (ER-17; the\nstrings are recorded in `docs/official-parity.yaml`).",
      "oneOf": [
        {
          "description": "Human verification: no authorized public surface.",
          "type": "string",
          "const": "human-verification"
        },
        {
          "description": "Organization SSO: no authorized public surface.",
          "type": "string",
          "const": "organization-sso"
        },
        {
          "description": "Guest login: not exposed by the pinned adapter on Linux.",
          "type": "string",
          "const": "guest-login"
        },
        {
          "description": "Connection feedback: out of scope for the required flows.",
          "type": "string",
          "const": "feedback"
        },
        {
          "description": "A challenge shape the pinned adapter cannot continue (for\nexample recovery codes).",
          "type": "string",
          "const": "unsupported-challenge"
        }
      ]
    },
    "LoginOutcome": {
      "description": "One step of a login-family flow on the wire (the S0/S4 adapter's\n`LoginStep`): a completed session, a continuation challenge, or a\nfail-closed stop with a stable reason.",
      "oneOf": [
        {
          "description": "The session is authenticated; login is complete.",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "session_id": {
                  "description": "The auth session ID.",
                  "type": "string"
                },
                "user_id": {
                  "description": "The Proton user ID.",
                  "type": "string"
                }
              },
              "required": [
                "user_id",
                "session_id"
              ]
            },
            "step": {
              "type": "string",
              "const": "session"
            }
          },
          "required": [
            "step",
            "data"
          ]
        },
        {
          "description": "A second factor is required before the session is usable.",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "fido2": {
                  "description": "FIDO2 ceremony parameters when the account has registered\nkeys.",
                  "anyOf": [
                    {
                      "$ref": "#/$defs/Fido2ChallengeParams"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "totp_enabled": {
                  "description": "TOTP is enabled for the account.",
                  "type": "boolean"
                }
              },
              "required": [
                "totp_enabled"
              ]
            },
            "step": {
              "type": "string",
              "const": "challenge"
            }
          },
          "required": [
            "step",
            "data"
          ]
        },
        {
          "description": "The flow has no authorized public continuation; the stable\nreason is carried for the client surfaces (ER-17).",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "reason": {
                  "description": "The stable refusal reason.",
                  "$ref": "#/$defs/LoginBlockedReason"
                }
              },
              "required": [
                "reason"
              ]
            },
            "step": {
              "type": "string",
              "const": "blocked"
            }
          },
          "required": [
            "step",
            "data"
          ]
        }
      ]
    },
    "NetworkIntegration": {
      "description": "Host network integration mode (PRD 6.6). ProtonWire always owns the tunnel\nand privacy policy; the mode only controls uplink observation and DNS\ncooperation.",
      "oneOf": [
        {
          "description": "Pick NetworkManager or systemd-networkd when either owns the default\nuplink, otherwise native.",
          "type": "string",
          "const": "auto"
        },
        {
          "description": "Observe netlink directly.",
          "type": "string",
          "const": "native"
        },
        {
          "description": "Cooperate with NetworkManager.",
          "type": "string",
          "const": "network-manager"
        },
        {
          "description": "Cooperate with systemd-networkd.",
          "type": "string",
          "const": "networkd"
        }
      ]
    },
    "NoticeLevel": {
      "description": "Severity for [`Event::Notice`].",
      "oneOf": [
        {
          "description": "Informational.",
          "type": "string",
          "const": "info"
        },
        {
          "description": "Warning.",
          "type": "string",
          "const": "warning"
        },
        {
          "description": "Error.",
          "type": "string",
          "const": "error"
        }
      ]
    },
    "PersistenceHealth": {
      "description": "Writable-store persistence health (ER-18). Carried only when the\nwritable-store half is wired and reporting.",
      "oneOf": [
        {
          "description": "Restart persistence is intact.",
          "type": "string",
          "const": "healthy"
        },
        {
          "description": "Restart persistence is at risk; operations requiring durable\nlogin must fail. The reason is value-free.",
          "type": "object",
          "properties": {
            "unhealthy": {
              "type": "object",
              "properties": {
                "reason": {
                  "description": "Value-free failure summary.",
                  "type": "string"
                }
              },
              "required": [
                "reason"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "unhealthy"
          ]
        }
      ]
    },
    "RequestResult": {
      "description": "Successful request outcomes.",
      "oneOf": [
        {
          "description": "Reply to [`Request::Ping`].",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "nonce": {
                  "type": "string"
                }
              },
              "required": [
                "nonce"
              ]
            },
            "result": {
              "type": "string",
              "const": "pong"
            }
          },
          "required": [
            "result",
            "data"
          ]
        },
        {
          "description": "Reply to [`Request::GetState`].",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "state": {
                  "$ref": "#/$defs/DaemonState"
                }
              },
              "required": [
                "state"
              ]
            },
            "result": {
              "type": "string",
              "const": "state"
            }
          },
          "required": [
            "result",
            "data"
          ]
        },
        {
          "description": "Reply to [`Request::Disconnect`] / [`Request::Shutdown`] /\n[`Request::Logout`] / [`Request::SubmitCredential`].",
          "type": "object",
          "properties": {
            "result": {
              "type": "string",
              "const": "acknowledged"
            }
          },
          "required": [
            "result"
          ]
        },
        {
          "description": "Reply to [`Request::ServersList`]: the cached catalog revision,\nserved verbatim (FR-10 — the raw upstream body, never\nrewritten), or all-`None` fields when nothing is cached yet.",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "body": {
                  "description": "The raw catalog JSON body, byte-for-byte as cached.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "etag": {
                  "description": "The cached revision's `ETag`, for diagnostics.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "fetched_unix": {
                  "description": "When this revision was fetched (Unix seconds); absent when\nno catalog is cached.",
                  "type": [
                    "integer",
                    "null"
                  ],
                  "format": "uint64",
                  "minimum": 0
                }
              }
            },
            "result": {
              "type": "string",
              "const": "servers"
            }
          },
          "required": [
            "result",
            "data"
          ]
        },
        {
          "description": "Reply to [`Request::ServersRefresh`]: the scheduler's report.",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "report": {
                  "description": "What the refresh did and what follows.",
                  "$ref": "#/$defs/ServersRefreshReport"
                }
              },
              "required": [
                "report"
              ]
            },
            "result": {
              "type": "string",
              "const": "servers-refreshed"
            }
          },
          "required": [
            "result",
            "data"
          ]
        },
        {
          "description": "Reply to the login family ([`Request::BeginLogin`],\n[`Request::SubmitTwoFactor`], [`Request::SubmitFidoPayload`]):\nthe next step of the flow, never a silent retry.",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "step": {
                  "description": "The step's outcome.",
                  "$ref": "#/$defs/LoginOutcome"
                }
              },
              "required": [
                "step"
              ]
            },
            "result": {
              "type": "string",
              "const": "login-step"
            }
          },
          "required": [
            "result",
            "data"
          ]
        },
        {
          "description": "Reply to [`Request::RefreshSession`]: the post-refresh status.",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "status": {
                  "description": "The session's login status after the refresh.",
                  "$ref": "#/$defs/SessionStatus"
                }
              },
              "required": [
                "status"
              ]
            },
            "result": {
              "type": "string",
              "const": "login-status"
            }
          },
          "required": [
            "result",
            "data"
          ]
        },
        {
          "description": "Reply to [`Request::GetAccount`]: the account snapshot.",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "account": {
                  "description": "The account facts.",
                  "$ref": "#/$defs/AccountStatus"
                }
              },
              "required": [
                "account"
              ]
            },
            "result": {
              "type": "string",
              "const": "account"
            }
          },
          "required": [
            "result",
            "data"
          ]
        }
      ]
    },
    "Response": {
      "description": "Reply to a request.",
      "oneOf": [
        {
          "description": "Successful outcome.",
          "type": "object",
          "properties": {
            "id": {
              "description": "Correlation id of the answered request.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "result": {
              "$ref": "#/$defs/RequestResult"
            },
            "type": {
              "type": "string",
              "const": "ok"
            }
          },
          "required": [
            "type",
            "id",
            "result"
          ]
        },
        {
          "description": "Failed outcome.",
          "type": "object",
          "properties": {
            "error": {
              "$ref": "#/$defs/RpcError"
            },
            "id": {
              "description": "Correlation id of the answered request.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "error"
            }
          },
          "required": [
            "type",
            "id",
            "error"
          ]
        }
      ]
    },
    "RpcError": {
      "description": "Structured RPC error payload.",
      "type": "object",
      "properties": {
        "code": {
          "description": "Machine-readable code; never localized.",
          "$ref": "#/$defs/RpcErrorCode"
        },
        "details": {
          "description": "Optional structured details."
        },
        "message": {
          "description": "Human-readable diagnostic message, already redacted.",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "RpcErrorCode": {
      "description": "Machine-readable error taxonomy crossing the IPC boundary. Codes align\nwith the PRD 9.8 exit codes where one exists; clients map them directly.",
      "oneOf": [
        {
          "description": "The requested capability is planned but not implemented yet.",
          "type": "string",
          "const": "not-implemented"
        },
        {
          "description": "The request parameters failed validation.",
          "type": "string",
          "const": "invalid-params"
        },
        {
          "description": "The client requested an unsupported protocol version.",
          "type": "string",
          "const": "unsupported-protocol"
        },
        {
          "description": "The authenticated peer is not allowed to perform the request.",
          "type": "string",
          "const": "permission-denied"
        },
        {
          "description": "No authenticated session exists for the peer's UID.",
          "type": "string",
          "const": "not-authenticated"
        },
        {
          "description": "The account is not entitled to the requested capability.",
          "type": "string",
          "const": "entitlement-missing"
        },
        {
          "description": "No server satisfies the requested constraints.",
          "type": "string",
          "const": "no-eligible-server"
        },
        {
          "description": "The network is unavailable.",
          "type": "string",
          "const": "network-unavailable"
        },
        {
          "description": "The tunnel failed to establish or broke down.",
          "type": "string",
          "const": "tunnel-failed"
        },
        {
          "description": "The kill switch could not be enforced.",
          "type": "string",
          "const": "kill-switch-failed"
        },
        {
          "description": "DNS could not be configured as requested.",
          "type": "string",
          "const": "dns-config-failed"
        },
        {
          "description": "Firewall (nftables) configuration failed.",
          "type": "string",
          "const": "firewall-failed"
        },
        {
          "description": "Split-tunnel policy could not be applied.",
          "type": "string",
          "const": "split-tunnel-failed"
        },
        {
          "description": "Port forwarding failed.",
          "type": "string",
          "const": "port-forwarding-failed"
        },
        {
          "description": "The daemon is busy and the request was not queued.",
          "type": "string",
          "const": "daemon-busy"
        },
        {
          "description": "The configuration failed validation.",
          "type": "string",
          "const": "config-invalid"
        },
        {
          "description": "The configured credential backend is unavailable.",
          "type": "string",
          "const": "credential-backend-unavailable"
        },
        {
          "description": "No Secure Core route satisfies the request.",
          "type": "string",
          "const": "secure-core-unavailable"
        },
        {
          "description": "The requested protocol is unavailable.",
          "type": "string",
          "const": "protocol-unavailable"
        },
        {
          "description": "The requested capability has no verified public upstream flow\n(human verification, organization SSO, guest mode, feedback):\nfail closed with a stable code and remediation, never an\nautomatic retry or an undocumented endpoint (ER-17).",
          "type": "string",
          "const": "upstream-capability-blocked"
        },
        {
          "description": "The upstream presented an authentication challenge this daemon\ncannot continue — an unknown 2FA or verification shape (PRD §7).\nFail closed: no retry, no untrusted URL, no approximation.",
          "type": "string",
          "const": "unsupported-challenge"
        },
        {
          "description": "The request requires explicit user confirmation before it may\nproceed — the FR-11 early manual catalog refresh now, the FR-7D\nraw-password-storage and FR-7EA none-store confirmations later.\n`details` carries the typed [`ConfirmationRequirement`]\nenvelope; a confirmed retry echoes its single-use token.",
          "type": "string",
          "const": "confirmation-required"
        },
        {
          "description": "The request was refused by a local suppression deadline or an\nupstream rate limit; the carried eligibility time governs the\nnext attempt and no path may bypass it (ER-16).",
          "type": "string",
          "const": "rate-limited"
        },
        {
          "description": "The writable credential store failed its health check: restart\npersistence is at risk and operations that require durable\nlogin must fail (ER-18).",
          "type": "string",
          "const": "credential-persistence-unhealthy"
        },
        {
          "description": "An internal daemon error without a more specific code.",
          "type": "string",
          "const": "internal"
        }
      ]
    },
    "ServersRefreshOutcome": {
      "description": "What one catalog refresh did.",
      "oneOf": [
        {
          "description": "A new catalog revision was fetched and committed.",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "etag": {
                  "description": "The new revision's `ETag`, when the API sent one.",
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "outcome": {
              "type": "string",
              "const": "changed"
            }
          },
          "required": [
            "outcome",
            "data"
          ]
        },
        {
          "description": "The stored revision was still current (an ETag match).",
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "not-modified"
            }
          },
          "required": [
            "outcome"
          ]
        },
        {
          "description": "The upstream rate-limited the refresh; the suppression\ndeadline in the report governs the next attempt.",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "retry_after_seconds": {
                  "description": "The `Retry-After` delay the API supplied, if any\n(already clamped at the adapter's parse seam).",
                  "type": [
                    "integer",
                    "null"
                  ],
                  "format": "uint64",
                  "minimum": 0
                }
              }
            },
            "outcome": {
              "type": "string",
              "const": "rate-limited"
            }
          },
          "required": [
            "outcome",
            "data"
          ]
        },
        {
          "description": "The refresh failed; `reason` is a stable, never-secret\ndescription.",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "reason": {
                  "description": "Stable failure description.",
                  "type": "string"
                }
              },
              "required": [
                "reason"
              ]
            },
            "outcome": {
              "type": "string",
              "const": "failed"
            }
          },
          "required": [
            "outcome",
            "data"
          ]
        }
      ]
    },
    "ServersRefreshReport": {
      "description": "The scheduler's report for one manual refresh (FR-11/FR-13I): what\nthe refresh did, whether this caller joined an in-flight refresh,\nand the pacing facts that follow.",
      "type": "object",
      "properties": {
        "coalesced": {
          "description": "`true` when this caller joined an already in-flight refresh\n(T-25 single-flight coalescing).",
          "type": "boolean"
        },
        "next_eligible_unix": {
          "description": "The next automatic eligibility the refresh set (Unix seconds).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "outcome": {
          "description": "What the refresh did.",
          "$ref": "#/$defs/ServersRefreshOutcome"
        },
        "suppression_until_unix": {
          "description": "The active suppression deadline after the refresh, if any\n(ER-16: no path may bypass it).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "outcome",
        "coalesced",
        "next_eligible_unix"
      ]
    },
    "SessionStatus": {
      "description": "Login status of the daemon's account session (the wire mirror of\nthe adapter's status).",
      "oneOf": [
        {
          "description": "No session exists.",
          "type": "string",
          "const": "logged-out"
        },
        {
          "description": "A session exists and is usable.",
          "type": "string",
          "const": "logged-in"
        },
        {
          "description": "A session exists but must be refreshed before use.",
          "type": "string",
          "const": "needs-refresh"
        }
      ]
    },
    "VpnState": {
      "description": "High-level VPN state machine states.",
      "oneOf": [
        {
          "description": "No tunnel exists.",
          "type": "string",
          "const": "disconnected"
        },
        {
          "description": "A connection attempt is in progress.",
          "type": "string",
          "const": "connecting"
        },
        {
          "description": "A tunnel is up.",
          "type": "string",
          "const": "connected"
        },
        {
          "description": "A teardown is in progress.",
          "type": "string",
          "const": "disconnecting"
        }
      ]
    },
    "WritableStoreStatus": {
      "description": "The configured writable-store facts (S5b/S5c own the resolution).",
      "type": "object",
      "properties": {
        "declared": {
          "description": "The declared `account.writable_session_store` vocabulary value.",
          "type": "string"
        },
        "priority": {
          "description": "The configured `account.writable_store_priority` order.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "declared",
        "priority"
      ]
    }
  }
}
