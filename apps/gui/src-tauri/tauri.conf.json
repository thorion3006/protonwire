{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProtonWire",
  "version": "0.1.0",
  "identifier": "network.protonwire.gui",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ProtonWire",
        "width": 1024,
        "height": 700,
        "minWidth": 800,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Network"
  }
}
